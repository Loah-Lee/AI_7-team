# ==========================================================================
# OpenAI
# ==========================================================================
OPENAI_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_MODEL=gpt-5-mini
REASONING_MODEL=gpt-5-mini

# ==========================================================================
# LangSmith (optional)
# ==========================================================================
LANGSMITH_API_KEY=lsv2_pt_your-api-key-here
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com/
LANGSMITH_PROJECT=biddingmate_ai7

# ==========================================================================
# Langfuse (optional)
# ==========================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ==========================================================================
# Retrieval / runtime tuning (optional)
# ==========================================================================
CHROMA_COLLECTION=chunks
INTENT_REGEX_FIRST=true
CSV_SHORTCIRCUIT_ENABLED=true
DEBUG_RETRIEVAL_TIMING=false
