# ============================================================================
# OpenAI API
# ============================================================================
OPENAI_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_MODEL=gpt-5-mini
REASONING_MODEL=gpt-5-mini

# ============================================================================
# LangSmith (트레이싱 및 모니터링)
# ============================================================================
LANGSMITH_API_KEY=lsv2_pt_your-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com/
LANGSMITH_PROJECT=biddingmate_ai7

# ============================================================================
# Langfuse (대안 트레이싱 - 선택사항)
# ============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================================================
# HuggingFace (선택사항)
# ============================================================================
HF_TOKEN=hf_your-token-here

# ============================================================================
# 기타 설정
# ============================================================================
CHROMA_DB_PATH=./data/chroma_db_v17

# 검색/컨텍스트 성능 튜닝 (선택)
RETRIEVAL_EXPANSION_CAP=3
RETRIEVAL_SEARCH_PASSES=1
RETRIEVAL_HIGH_RECALL_K_MULTIPLIER=0.8
CONTEXT_TOP_RESULTS=6
CONTEXT_MAX_CHARS=700
RETRIEVAL_MAX_HYBRID_CALLS=6
KEYWORD_SCAN_LIMIT=1200
INTENT_REGEX_FIRST=true
DEBUG_RETRIEVAL_TIMING=false
ANSWER_QUALITY_MODE=balanced
CSV_SHORTCIRCUIT_ENABLED=true
HYBRID_LEXICAL_PREFILTER_K=120
HYBRID_LEXICAL_MIN_HITS=1
HYBRID_RERANK_TOP_MULTIPLIER=4
